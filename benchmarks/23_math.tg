/* Math module: rounding, roots, powers, logarithms, trigonometry, min/max, and domain errors. */
print("Math");

print("ceil", math.ceil(2.1), math.ceil(2), math.ceil(-2.1), math.ceil(-0.9), math.ceil(0.0001));
print("floor", math.floor(2.9), math.floor(2), math.floor(-2.1), math.floor(-0.0001), math.floor(0.9999));
print("round", math.round(0.5), math.round(1.5), math.round(2.5), math.round(-1.5), math.round(-2.5), math.round(2.4999), math.round(7.51));
print("abs", math.abs(-12), math.abs(12), math.abs(-0.25), math.abs(3 - 10));
print("sqrt", math.sqrt(0), math.sqrt(1), math.sqrt(144), math.sqrt(0.25), math.sqrt(2.25));
print("pow", math.pow(2, 0), math.pow(2, 8), math.pow(-2, 3), math.pow(-2, 4), math.pow(4, -1), math.pow(16, 0.5), math.pow(10, 6));
print("min/max", math.min(4, 9), math.max(4, 9), math.min(-1, -1.5), math.max(-1, -1.5), math.min(0, 0));

function fixed(value, places) {
    const scale = math.pow(10, places);
    return math.round(value * scale) / scale;
}

function log_base(value, base) {
    return math.log(value) / math.log(base);
}

print("log", math.log(1), fixed(math.log(2), 4), fixed(math.log(10), 4), fixed(math.log(0.5), 4));
print("log base", math.round(log_base(1000, 10)), math.round(log_base(1024, 2)), fixed(log_base(50, 10), 3));

const PI = 3.141592653589793;
print("sin", math.sin(0), fixed(math.sin(PI / 6), 4), fixed(math.sin(PI / 2), 4), fixed(math.sin(PI), 4), fixed(math.sin(-PI / 2), 4));
print("cos", math.cos(0), fixed(math.cos(PI / 3), 4), fixed(math.cos(PI / 2), 4), fixed(math.cos(PI), 4));
print("tan", math.tan(0), fixed(math.tan(PI / 4), 4), fixed(math.tan(-PI / 4), 4), fixed(math.tan(1), 4));

var identity = true;
for angle in [0, 0.5, 1, 2, 3] {
    const total = math.pow(math.sin(angle), 2) + math.pow(math.cos(angle), 2);
    if math.abs(total - 1) > 0.000000001 {
        identity = false;
    }
}
print("identity", identity);

function distance(x1, y1, x2, y2) {
    return math.sqrt(math.pow(x2 - x1, 2) + math.pow(y2 - y1, 2));
}
print("distance", distance(0, 0, 3, 4), distance(1, 1, 4, 5), distance(-2, 3, 4, -5));

function circle_area(radius) {
    return fixed(PI * radius * radius, 2);
}
print("areas", circle_area(1), circle_area(2), circle_area(10));

function clamp(value, low, high) {
    return math.max(low, math.min(value, high));
}
var clamped = [];
for reading in [-5, 0, 42, 100, 250] {
    clamped += [clamp(reading, 0, 100)];
}
print("clamp", clamped);

const scores = [72.5, 88, 91.25, 64, 79];
var lowest = scores[0];
var highest = scores[0];
var total = 0;
for score in scores {
    lowest = math.min(lowest, score);
    highest = math.max(highest, score);
    total += score;
}
const mean = total / len(scores);
print("scores", lowest, highest, mean, math.round(mean), math.floor(mean), math.ceil(mean));

var squares = 0;
for score in scores {
    squares += math.pow(score - mean, 2);
}
print("stddev", fixed(math.sqrt(squares / len(scores)), 3));

function compound(principal, rate, years) {
    return fixed(principal * math.pow(1 + rate, years), 2);
}
print("interest", compound(1000, 0.05, 0), compound(1000, 0.05, 1), compound(1000, 0.05, 10), compound(250, 0.1, 3));

var perfect = [];
for n in range(1, 50) {
    const root = math.floor(math.sqrt(n));
    if root * root == n {
        perfect += [n];
    }
}
print("perfect squares", perfect);

function is_prime(n) {
    if n < 2 {
        return false;
    }
    const limit = math.floor(math.sqrt(n));
    cfor (var divisor = 2; divisor <= limit; divisor++) {
        if n % divisor == 0 {
            return false;
        }
    }
    return true;
}
var primes = [];
for n in range(2, 40) {
    if is_prime(n) {
        primes += [n];
    }
}
print("primes", primes);

var halves = [];
for value in [0.5, 1.5, 2.5, 3.5, 4.5, -0.5, -1.5] {
    halves += [math.round(value)];
}
print("halves", halves);

const operations = {"ceil": math.ceil, "floor": math.floor, "round": math.round, "abs": math.abs};
for name in ["ceil", "floor", "round", "abs"] {
    print("apply", name, operations[name](-3.5));
}

var values = [-7, 3, -1, 5, -4];
values.sort(key=math.abs);
print("by abs", values);

const failing = [[math.sqrt, -4], [math.log, 0], [math.log, -1]];
for pair in failing {
    try {
        pair[0](pair[1]);
        print("unexpected");
    } catch (error) {
        print("caught", pair[0], "math domain error" in error);
    }
}

try {
    math.pow(0, -1);
} catch (error) {
    print("pow zero", "math.pow: math domain error" in error);
}

try {
    math.pow(10, 400);
} catch (error) {
    print("pow huge", "math.pow: math range error" in error);
}

try {
    math.sqrt("9");
} catch (error) {
    print("string arg", "math.sqrt expects a number, got string" in error);
}

try {
    math.max(1);
} catch (error) {
    print("arity", "math.max expects 2 arguments, got 1" in error);
}

try {
    math.floor = math.ceil;
} catch (error) {
    print("read only", "cannot assign" in error);
}

function shadow() {
    const math = {"answer": 42};
    return math["answer"];
}
print("shadow", shadow(), math.sqrt(49));
print("module", math);
