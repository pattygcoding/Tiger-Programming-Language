const TITLE = "Sorting and searching";
const SAMPLE = [5, 1, 3, 3, -2, 8, 0];

function bubble_sort(values) {
    const result = values + [];
    var end = len(result) - 1;
    while end > 0 {
        var position = 0;
        while position < end {
            if result[position] > result[position + 1] {
                const saved = result[position];
                result[position] = result[position + 1];
                result[position + 1] = saved;
            }
            position = position + 1;
        }
        end = end - 1;
    }
    return result;
}

function insertion_sort(values) {
    const result = values + [];
    var position = 1;
    while position < len(result) {
        const saved = result[position];
        var previous = position - 1;
        while previous >= 0 and result[previous] > saved {
            result[previous + 1] = result[previous];
            previous = previous - 1;
        }
        result[previous + 1] = saved;
        position = position + 1;
    }
    return result;
}

function selection_sort(values) {
    const result = values + [];
    var position = 0;
    while position < len(result) {
        var smallest = position;
        var candidate = position + 1;
        while candidate < len(result) {
            if result[candidate] < result[smallest] {
                smallest = candidate;
            }
            candidate = candidate + 1;
        }
        const saved = result[position];
        result[position] = result[smallest];
        result[smallest] = saved;
        position = position + 1;
    }
    return result;
}

function binary_search(values, target) {
    var lower = 0;
    var upper = len(values) - 1;
    while lower <= upper {
        const combined = lower + upper;
        const middle = (combined - combined % 2) / 2;
        if values[middle] == target {
            return middle;
        } elif values[middle] < target {
            lower = middle + 1;
        } else {
            upper = middle - 1;
        }
    }
    return -1;
}

function lower_bound(values, target) {
    var position = 0;
    while position < len(values) and values[position] < target {
        position = position + 1;
    }
    return position;
}

function count_value(values, target) {
    var total = 0;
    for value in values {
        if value == target {
            total = total + 1;
        }
    }
    return total;
}

function is_sorted(values) {
    var position = 1;
    while position < len(values) {
        if values[position - 1] > values[position] {
            return false;
        }
        position = position + 1;
    }
    return true;
}

function reversed(values) {
    var result = [];
    var position = len(values) - 1;
    while position >= 0 {
        result = result + [values[position]];
        position = position - 1;
    }
    return result;
}

const ORDERED = bubble_sort(SAMPLE);
print(TITLE);
print("bubble:", ORDERED);
print("insertion:", insertion_sort(SAMPLE));
print("selection:", selection_sort(SAMPLE));
print("unchanged:", SAMPLE);
print("empty:", bubble_sort([]), insertion_sort([]), selection_sort([]));
print("singleton:", bubble_sort([7]), insertion_sort([7]));
print("search:", binary_search(ORDERED, -2), binary_search(ORDERED, 3), binary_search(ORDERED, 8));
print("missing:", binary_search(ORDERED, 4), binary_search([], 1));
print("bounds:", lower_bound(ORDERED, 3), lower_bound(ORDERED, 4), lower_bound(ORDERED, 99));
print("counts:", count_value(ORDERED, 3), count_value(ORDERED, 9));
print("sorted:", is_sorted(SAMPLE), is_sorted(ORDERED), is_sorted([]));
print("reverse:", reversed(ORDERED));
print("agreement:", ORDERED == insertion_sort(SAMPLE), ORDERED == selection_sort(SAMPLE));