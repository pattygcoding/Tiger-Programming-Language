const TITLE = "Matrix operations";

def zeros(rows, columns) {
    matrix = [];
    row_index = 0;
    while row_index < rows {
        row = [];
        column_index = 0;
        while column_index < columns {
            row = row + [0];
            column_index = column_index + 1;
        }
        matrix = matrix + [row];
        row_index = row_index + 1;
    }
    return matrix;
}

def identity(size) {
    matrix = zeros(size, size);
    diagonal = 0;
    while diagonal < size {
        matrix[diagonal][diagonal] = 1;
        diagonal = diagonal + 1;
    }
    return matrix;
}

def transpose(matrix) {
    rows = len(matrix);
    columns = len(matrix[0]);
    result = zeros(columns, rows);
    row_index = 0;
    while row_index < rows {
        column_index = 0;
        while column_index < columns {
            result[column_index][row_index] = matrix[row_index][column_index];
            column_index = column_index + 1;
        }
        row_index = row_index + 1;
    }
    return result;
}

def add(left, right) {
    result = zeros(len(left), len(left[0]));
    row_index = 0;
    while row_index < len(left) {
        column_index = 0;
        while column_index < len(left[0]) {
            result[row_index][column_index] = left[row_index][column_index] + right[row_index][column_index];
            column_index = column_index + 1;
        }
        row_index = row_index + 1;
    }
    return result;
}

def multiply(left, right) {
    result = zeros(len(left), len(right[0]));
    row_index = 0;
    while row_index < len(left) {
        column_index = 0;
        while column_index < len(right[0]) {
            shared = 0;
            while shared < len(right) {
                result[row_index][column_index] = result[row_index][column_index] + left[row_index][shared] * right[shared][column_index];
                shared = shared + 1;
            }
            column_index = column_index + 1;
        }
        row_index = row_index + 1;
    }
    return result;
}

def scale(matrix, factor) {
    result = zeros(len(matrix), len(matrix[0]));
    row_index = 0;
    while row_index < len(matrix) {
        column_index = 0;
        while column_index < len(matrix[0]) {
            result[row_index][column_index] = matrix[row_index][column_index] * factor;
            column_index = column_index + 1;
        }
        row_index = row_index + 1;
    }
    return result;
}

def trace(matrix) {
    total = 0;
    diagonal = 0;
    while diagonal < len(matrix) {
        total = total + matrix[diagonal][diagonal];
        diagonal = diagonal + 1;
    }
    return total;
}

def row_sums(matrix) {
    result = [];
    for row in matrix {
        total = 0;
        for value in row {
            total = total + value;
        }
        result = result + [total];
    }
    return result;
}

const LEFT = [[1, 2, 3], [4, 5, 6]];
const RIGHT = [[7, 8], [9, 10], [11, 12]];
const PRODUCT = multiply(LEFT, RIGHT);

print(TITLE);
print("zeros:", zeros(2, 3));
print("identity:", identity(3));
print("transpose:", transpose(LEFT));
print("product:", PRODUCT);
print("sum:", add(LEFT, LEFT));
print("scaled:", scale(LEFT, -1));
print("trace:", trace(PRODUCT), trace(identity(4)));
print("rows:", row_sums(LEFT), row_sums(PRODUCT));
print("identity law:", multiply(LEFT, identity(3)) == LEFT);
print("transpose law:", transpose(transpose(LEFT)) == LEFT);
print("unchanged:", LEFT);
print("empty:", zeros(0, 3), identity(0));