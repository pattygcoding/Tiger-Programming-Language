const TITLE = "Account state and inheritance";

class Account {
    function init(this, owner, opening) {
        this.owner = owner;
        this.balance = opening;
        this.history = [opening];
    }

    function record(this) {
        this.history = this.history + [this.balance];
    }

    function deposit(this, amount) {
        if amount < 0 {
            return false;
        }
        this.balance = this.balance + amount;
        this.record();
        return true;
    }

    function withdraw(this, amount) {
        if amount < 0 or amount > this.balance {
            return false;
        }
        this.balance = this.balance - amount;
        this.record();
        return true;
    }

    function summary(this) {
        return this.owner + "=" + str(this.balance);
    }
}

class Savings(Account) {
    function init(this, owner, opening, percent) {
        super.init(owner, opening);
        this.percent = percent;
    }

    function interest(this) {
        const amount = this.balance * this.percent / 100;
        this.deposit(amount);
        return amount;
    }
}

class FeeAccount(Account) {
    function init(this, owner, opening, fee) {
        super.init(owner, opening);
        this.fee = fee;
        this.fees_paid = 0;
    }

    function withdraw(this, amount) {
        if amount < 0 {
            return false;
        }
        if super.withdraw(amount + this.fee) {
            this.fees_paid = this.fees_paid + this.fee;
            return true;
        }
        return false;
    }
}

class Bank {
    function init(this) {
        this.accounts = {};
    }

    function add(this, account) {
        if account.owner in this.accounts {
            return false;
        }
        this.accounts[account.owner] = account;
        return true;
    }

    function total(this) {
        var total = 0;
        for owner in this.accounts {
            total = total + this.accounts[owner].balance;
        }
        return total;
    }

    function transfer(this, source, destination, amount) {
        if not source in this.accounts or not destination in this.accounts {
            return false;
        }
        if source == destination or amount < 0 {
            return false;
        }
        if not this.accounts[source].withdraw(amount) {
            return false;
        }
        return this.accounts[destination].deposit(amount);
    }
}

const ALICE = Savings("Alice", 100, 10);
const BOB = FeeAccount("Bob", 80, 2);
const BANK = Bank();
print(TITLE);
print("register:", BANK.add(ALICE), BANK.add(BOB), BANK.add(ALICE));
print("interest:", ALICE.interest());
print("deposit:", BOB.deposit(20));
print("transfer:", BANK.transfer("Alice", "Bob", 30));
print("withdraw:", BOB.withdraw(10), BOB.withdraw(1000));
print("summaries:", ALICE.summary(), BOB.summary());
print("total:", BANK.total(), "fees:", BOB.fees_paid);
print("history:", ALICE.history, BOB.history);
print("invalid:", BANK.transfer("missing", "Bob", 1), BANK.transfer("Alice", "Alice", 1));
print("negative:", ALICE.deposit(-1), BOB.withdraw(-1));
const SAVED_DEPOSIT = ALICE.deposit;
print("saved:", SAVED_DEPOSIT(5), ALICE.balance);
print("independent:", Account("Other", 7).history, BOB.balance);
print("final:", BANK.total());