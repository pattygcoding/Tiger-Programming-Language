const TITLE = "Text processing";
const ALPHABET = "abcdefghijklmnopqrstuvwxyz";

function reverse(text) {
    var result = "";
    var position = len(text) - 1;
    while position >= 0 {
        result = result + text[position];
        position = position - 1;
    }
    return result;
}

function words(text) {
    var result = [];
    var current = "";
    for character in text {
        if character == " " or character == "\t" or character == "\n" {
            if len(current) > 0 {
                result = result + [current];
                current = "";
            }
        } else {
            current = current + character;
        }
    }
    if len(current) > 0 {
        result = result + [current];
    }
    return result;
}

function join(parts, separator) {
    var result = "";
    var position = 0;
    for part in parts {
        if position > 0 {
            result = result + separator;
        }
        result = result + part;
        position = position + 1;
    }
    return result;
}

function frequencies(text) {
    const counts = {};
    for word in words(text) {
        if word in counts {
            counts[word] = counts[word] + 1;
        } else {
            counts[word] = 1;
        }
    }
    return counts;
}

function unique_characters(text) {
    var result = "";
    const seen = {};
    for character in text {
        if not character in seen {
            seen[character] = true;
            result = result + character;
        }
    }
    return result;
}

function shift_character(character, distance) {
    var position = 0;
    while position < len(ALPHABET) {
        if ALPHABET[position] == character {
            return ALPHABET[(position + distance) % len(ALPHABET)];
        }
        position = position + 1;
    }
    return character;
}

function caesar(text, distance) {
    var result = "";
    for character in text {
        result = result + shift_character(character, distance);
    }
    return result;
}

function run_length(text) {
    if len(text) == 0 {
        return "";
    }
    var result = "";
    var previous = text[0];
    var count = 1;
    var position = 1;
    while position < len(text) {
        if text[position] == previous {
            count = count + 1;
        } else {
            result = result + previous + str(count);
            previous = text[position];
            count = 1;
        }
        position = position + 1;
    }
    return result + previous + str(count);
}

function starts_with(text, prefix) {
    if len(prefix) > len(text) {
        return false;
    }
    var position = 0;
    while position < len(prefix) {
        if text[position] != prefix[position] {
            return false;
        }
        position = position + 1;
    }
    return true;
}

function repeat(text, count) {
    var result = "";
    var position = 0;
    while position < count {
        result = result + text;
        position = position + 1;
    }
    return result;
}

print(TITLE);
print("reverse:", reverse("Tiger 123"));
print("words:", words("  red\tblue\nred  green "));
print("join:", join(["one", "two", "three"], "|"));
print("counts:", frequencies("red blue red green blue red"));
print("unique:", unique_characters("mississippi"));
print("cipher:", caesar("tiger zoo!", 3));
print("decipher:", caesar("wljhu crr!", -3));
print("runs:", run_length("aaabbcaaa"), run_length("x"));
print("prefix:", starts_with("tiger", "tig"), starts_with("tiger", "tiny"), starts_with("", ""));
print("repeat:", repeat("ab", 4));
print("empty:", words(" \t\n"), len(join([], ",")), len(run_length("")), len(repeat("x", 0)));
print("membership:", "ger" in "tiger", "xyz" in "tiger");