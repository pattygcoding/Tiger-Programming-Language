// 37_function_ergonomics.tg - defaults, anonymous functions, multiple returns,
// and destructuring.
//
// Exercises default parameter values (positional, keyword, closure-captured,
// and method), anonymous function expressions used as values, sort keys, and
// immediates, multiple return values unpacked by position, list and dictionary
// destructuring, and their error paths handled with try/catch.

print("== default parameters ==");
function greet(name, greeting = "hello") {
    return greeting + " " + name;
}
print(greet("world"), greet("world", "hi"), greet(name="ace"));
function add(a, b = 10, c = 100) {
    return a + b + c;
}
print(add(1), add(1, 2), add(1, 2, 3), add(1, c=0));
const base = 5;
function scale(value, factor = base) {
    return value * factor;
}
print(scale(3), scale(3, 2));
class Counter {
    var step = 1;
    function bump(amount = 2) {
        return amount + this.step;
    }
}
print(Counter().bump(), Counter().bump(10));

print("== anonymous functions ==");
const double = function(value) { return value * 2; };
print(double(4));
const words = ["ccc", "a", "bb", "dddd"];
words.sort(key=function(word) { return len(word); });
print(words);
print(function(a, b = 2) { return a + b; }(3));
function make_adder(amount) {
    return function(value) { return value + amount; };
}
const add5 = make_adder(5);
print(add5(3));
function apply_all(values, action) {
    var result = [];
    for value in values {
        result = result + [action(value)];
    }
    return result;
}
print(apply_all([1, 2, 3], function(value) { return value * value; }));
print(function() { return 1; });

print("== multiple returns and destructuring ==");
function min_max(values) {
    var low = values[0];
    var high = values[0];
    for value in values {
        if value < low { low = value; }
        if value > high { high = value; }
    }
    return low, high;
}
const [low, high] = min_max([3, 1, 4, 1, 5]);
print(low, high, min_max([2, 9]));
function swap(a, b) {
    return b, a;
}
var [first, second] = swap(1, 2);
print(first, second);
const record = {"name": "tiger", "legs": 4};
const {name, legs} = record;
print(name, legs);
function stats(values) {
    return len(values), min_max(values);
}
const [count, bounds] = stats([4, 8, 2]);
print(count, bounds);

print("== errors ==");
function fails(action) {
    try {
        action();
        return "no error";
    } catch (error) {
        return str(error);
    }
}
function missing() {
    return add();
}
function unpack_short() {
    var [x, y, z] = min_max([1, 2]);
    return x;
}
function wrong_type() {
    var [x] = 5;
    return x;
}
function missing_key() {
    var {absent} = record;
    return absent;
}
print("expects" in fails(missing));
print("cannot unpack" in fails(unpack_short));
print("expected a list" in fails(wrong_type));
print("missing key" in fails(missing_key));

print("done");
