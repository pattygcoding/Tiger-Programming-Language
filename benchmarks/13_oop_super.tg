const TITLE = "Lexical super and inherited constructors";

class Root {
    function init(this, name) {
        this.name = name;
        this.trail = ["root"];
    }

    function label(this) {
        return "root:" + this.name;
    }

    function level(this) {
        return 1;
    }

    function describe(this) {
        return this.label() + "@" + str(this.level());
    }

    function rename(this, name) {
        this.name = name;
        return this;
    }
}

class Middle(Root) {
    function init(this, name) {
        super.init(name);
        this.trail = this.trail + ["middle"];
    }

    function label(this) {
        return super.label() + "/middle";
    }

    function level(this) {
        return super.level() + 1;
    }

    function root_callback(this) {
        function later() {
            return super.label();
        }
        return later;
    }

    function root_method(this) {
        return super.label;
    }
}

class Leaf(Middle) {
    function init(this, name) {
        super.init(name);
        this.trail = this.trail + ["leaf"];
    }

    function label(this) {
        return super.label() + "/leaf";
    }

    function level(this) {
        return super.level() + 1;
    }

    function parent_label(this) {
        return super.label();
    }
}

class Inherited(Leaf) {
}

class Final(Inherited) {
    function label(this) {
        return super.label() + "/final";
    }

    function level(this) {
        return super.level() + 1;
    }
}

function descriptions(objects) {
    var result = [];
    for item in objects {
        result = result + [item.describe()];
    }
    return result;
}

function make_local(prefix) {
    class Local(Root) {
        function label(this) {
            return prefix + super.label();
        }
    }
    return Local;
}

const BASE = Root("A");
const MID = Middle("B");
const LEAF = Leaf("C");
const INHERITED = Inherited("D");
const FINAL = Final("E");
const CALLBACK = FINAL.root_callback();
const ROOT_METHOD = FINAL.root_method();
const LOCAL = make_local("local/");

print(TITLE);
for description in descriptions([BASE, MID, LEAF, INHERITED, FINAL]) {
    print(description);
}
print("trails:", BASE.trail, MID.trail, FINAL.trail);
print("parent:", FINAL.parent_label());
print("callback:", CALLBACK(), ROOT_METHOD());
FINAL.rename("Renamed");
print("renamed:", CALLBACK(), ROOT_METHOD(), FINAL.describe());
print("independent:", LEAF.name, INHERITED.name);
print("local:", LOCAL("X").describe());
const ROOT_ALIAS = Root;
Root = 7;
print("stable parent:", FINAL.label(), ROOT_ALIAS("Z").label());
print("inherited init:", Final("Fresh").trail);
print("bound equality:", ROOT_METHOD == FINAL.root_method());