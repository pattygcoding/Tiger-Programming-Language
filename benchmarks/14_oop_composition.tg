const TITLE = "Object composition and recursive projects";

class Task {
    function init(this, title, hours) {
        this.title = title;
        this.hours = hours;
        this.done = false;
    }

    function complete(this) {
        this.done = true;
        return this;
    }

    function reopen(this) {
        this.done = false;
        return this;
    }

    function estimate(this) {
        if this.done {
            return 0;
        }
        return this.hours;
    }

    function describe(this) {
        if this.done {
            return this.title + ":done";
        }
        return this.title + ":" + str(this.hours);
    }
}

class Project {
    function init(this, name) {
        this.name = name;
        this.tasks = [];
        this.projects = [];
    }

    function add_task(this, task) {
        this.tasks = this.tasks + [task];
        return this;
    }

    function add_project(this, project) {
        this.projects = this.projects + [project];
        return this;
    }

    function estimate(this) {
        var total = 0;
        for task in this.tasks {
            total = total + task.estimate();
        }
        for project in this.projects {
            total = total + project.estimate();
        }
        return total;
    }

    function find(this, title) {
        for task in this.tasks {
            if task.title == title {
                return task;
            }
        }
        for project in this.projects {
            const found = project.find(title);
            if found != null {
                return found;
            }
        }
        return null;
    }

    function report(this) {
        var result = [];
        for task in this.tasks {
            result = result + [task.describe()];
        }
        for project in this.projects {
            result = result + project.report();
        }
        return result;
    }

    function complete_all(this) {
        for task in this.tasks {
            task.complete();
        }
        for project in this.projects {
            project.complete_all();
        }
    }
}

const DESIGN = Task("Design", 3);
const BUILD = Task("Build", 5);
const UNIT = Task("Unit", 2);
const INTEGRATION = Task("Integration", 4);
const QA = Project("QA").add_task(UNIT).add_task(INTEGRATION);
const APP = Project("App").add_task(DESIGN).add_task(BUILD).add_project(QA);
const EMPTY = Project("Empty");

print(TITLE);
print("initial:", APP.estimate(), QA.estimate());
BUILD.complete();
print("after build:", APP.estimate());
APP.find("Integration").complete();
print("after integration:", APP.estimate(), QA.estimate());
print("report:", APP.report());
print("identity:", APP.find("Unit") == UNIT);
print("missing:", APP.find("Missing"));
APP.tasks[0].hours = 4;
print("shared field:", DESIGN.hours, APP.estimate());
const LOOKUP = APP.find;
print("bound lookup:", LOOKUP("Design").title);
APP.complete_all();
print("complete:", APP.estimate(), APP.report());
LOOKUP("Build").reopen();
print("reopened:", BUILD.done, APP.estimate());
print("empty:", EMPTY.estimate(), EMPTY.report(), EMPTY.find("Unit"));
print("independent:", len(EMPTY.tasks), len(QA.tasks), len(APP.projects));