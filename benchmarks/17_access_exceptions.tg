/* Public defaults, restricted state, callbacks, and recoverable failures. */
class Account {
    const currency = "USD";
    var label = "account";
    private var balance = 0;
    protected var operations = 0;
    var history = [];

    Account(amount) {
        this.balance = amount;
    }

    private function validate(amount) {
        if amount < 0 {
            throw {"reason": "negative", "amount": amount};
        }
    }

    public function deposit(amount) {
        this.validate(amount);
        this.balance = this.balance + amount;
        this.operations++;
        this.history = this.history + [amount];
        return this.balance;
    }

    function total() {
        return this.balance;
    }

    function reader() {
        function read() {
            return this.balance;
        }
        return read;
    }
}

class AuditedAccount extends Account {
    function count() {
        return this.operations;
    }

    function deposit(amount) {
        return super.deposit(amount);
    }
}

const first = AuditedAccount(10);
const second = AuditedAccount(5);
const read = first.reader();
for amount in range(1, 4) {
    first.deposit(amount);
}
print(f"balances {read()} {second.total()}");
print(f"metadata {first.currency} {first.label} {first.count()}");
print(f"histories {first.history} {second.history}");

try {
    first.deposit(-7);
} catch (error) {
    print("rejected", error["reason"], error["amount"]);
}
print("unchanged", first.total(), first.count());

try {
    print(first.balance);
} catch (error) {
    print("private", "cannot access private" in error);
}

try {
    first.operations++;
} catch (error) {
    print("protected", "cannot access protected" in error);
}

try {
    first.currency = "EUR";
} catch (error) {
    print("constant", "cannot reassign const field" in error);
}

function guarded(value) {
    try {
        if value == 0 {
            throw "zero";
        }
        return 12 / value;
    } catch (error) {
        return "caught " + error;
    }
}
print("guarded", guarded(3), guarded(0));

try {
    try {
        throw [1, 2];
    } catch (inner) {
        throw inner + [3];
    }
} catch (outer) {
    print("rethrow", outer);
}

var recovered = 0;
cfor (var index = 0; index < 3; index++) {
    try {
        print(1 / 0);
    } catch (error) {
        recovered++;
        continue;
    }
} else {
    print("recovered", recovered);
}

print("== finally ==");
var trace = [];
try {
    trace = trace + ["body"];
} finally {
    trace = trace + ["finally"];
}
print("normal", trace);

trace = [];
try {
    throw "boom";
} catch (error) {
    trace = trace + ["caught"];
} finally {
    trace = trace + ["finally"];
}
print("caught", trace);

trace = [];
try {
    try {
        throw "boom";
    } finally {
        trace = trace + ["inner"];
    }
} catch (error) {
    trace = trace + ["outer"];
}
print("uncaught", trace);

function with_finally() {
    try { return "value"; } finally { trace = trace + ["return"]; }
}
trace = [];
print("return", with_finally(), trace);

function override() {
    try { throw "boom"; } finally { return "override"; }
}
print("override", override());

trace = [];
for index in [1, 2, 3] {
    try {
        if index == 2 { continue; }
        trace = trace + [index];
    } finally {
        trace = trace + ["f"];
    }
}
print("continue", trace);

print("== structured errors ==");
try {
    print(1 / 0);
} catch (error) {
    print(type(error), error["kind"], "division by zero" in error, isinstance(error, "error"));
}
try {
    const items = [1, 2];
    print(items[9]);
} catch (error) {
    print(error["kind"], error["origin"] == "");
}

print("== typed catch ==");
function classify(value) {
    try {
        if value == 0 { throw "custom"; }
        return [10, 20][value];
    } catch (error) if isinstance(error, "error") and error["kind"] == "index range" {
        return "range";
    } catch (error) {
        return "other";
    }
}
print(classify(1), classify(5), classify(0));

print("done");