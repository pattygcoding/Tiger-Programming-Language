const TITLE = "Closures and higher-order functions";

function make_counter(start, step) {
    var value = start;
    function next() {
        value = value + step;
        return value;
    }
    return next;
}

function make_multiplier(factor) {
    function multiply(value) {
        return value * factor;
    }
    return multiply;
}

function make_adder(offset) {
    function add(value) {
        return value + offset;
    }
    return add;
}

function compose(outer, inner) {
    function combined(value) {
        return outer(inner(value));
    }
    return combined;
}

function map_values(values, transform) {
    var result = [];
    for value in values {
        result = result + [transform(value)];
    }
    return result;
}

function filter_values(values, predicate) {
    var result = [];
    for value in values {
        if predicate(value) {
            result = result + [value];
        }
    }
    return result;
}

function reduce_values(values, combine, initial) {
    var result = initial;
    for value in values {
        result = combine(result, value);
    }
    return result;
}

function sum_pair(left, right) {
    return left + right;
}

function product_pair(left, right) {
    return left * right;
}

function is_even(value) {
    return value % 2 == 0;
}

function make_account(opening) {
    var balance = opening;
    function deposit(amount) {
        if amount < 0 {
            return false;
        }
        balance = balance + amount;
        return balance;
    }
    function withdraw(amount) {
        if amount < 0 or amount > balance {
            return false;
        }
        balance = balance - amount;
        return balance;
    }
    function current() {
        return balance;
    }
    return {"deposit": deposit, "withdraw": withdraw, "balance": current};
}

function make_transforms(factors) {
    var result = [];
    for factor in factors {
        function transform(value) {
            return value * factor;
        }
        result = result + [transform];
    }
    return result;
}

const FIRST = make_counter(0, 2);
const SECOND = make_counter(10, -1);
const DOUBLE = make_multiplier(2);
const PIPELINE = compose(DOUBLE, make_adder(3));
const ACCOUNT = make_account(100);
const OTHER = make_account(7);
const TRANSFORMS = make_transforms([2, 3, 4]);

print(TITLE);
print("counters:", FIRST(), FIRST(), SECOND(), SECOND(), FIRST());
print("map:", map_values([1, 2, 3, 4], DOUBLE));
print("compose:", PIPELINE(5), PIPELINE(-3));
print("filter:", filter_values([1, 2, 3, 4, 5, 6], is_even));
print("reduce:", reduce_values([1, 2, 3, 4], sum_pair, 0), reduce_values([1, 2, 3, 4], product_pair, 1));
print("deposit:", ACCOUNT["deposit"](25));
print("withdraw:", ACCOUNT["withdraw"](40), ACCOUNT["withdraw"](1000));
print("balances:", ACCOUNT["balance"](), OTHER["balance"]());
print("invalid:", ACCOUNT["deposit"](-5), ACCOUNT["withdraw"](-1));
print("loop captures:", TRANSFORMS[0](5), TRANSFORMS[1](5), TRANSFORMS[2](5));
print("empty:", map_values([], DOUBLE), filter_values([], is_even), reduce_values([], sum_pair, 9));
print("function identity:", DOUBLE == DOUBLE, DOUBLE == make_multiplier(2));