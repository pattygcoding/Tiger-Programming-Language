const TITLE = "Polymorphic shapes";

class Shape {
    function init(this, label) {
        this.label = label;
    }

    function area(this) {
        return 0;
    }

    function perimeter(this) {
        return 0;
    }

    function describe(this) {
        return this.label + ": area=" + str(this.area()) + ", perimeter=" + str(this.perimeter());
    }
}

class Rectangle(Shape) {
    function init(this, width, height) {
        super.init("rectangle");
        this.width = width;
        this.height = height;
    }

    function area(this) {
        return this.width * this.height;
    }

    function perimeter(this) {
        return 2 * (this.width + this.height);
    }

    function scale(this, factor) {
        this.width = this.width * factor;
        this.height = this.height * factor;
        return this;
    }
}

class Square(Rectangle) {
    function init(this, side) {
        super.init(side, side);
        this.label = "square";
    }

    function side(this) {
        return this.width;
    }

    function describe(this) {
        return super.describe() + ", side=" + str(this.side());
    }
}

class RightTriangle(Shape) {
    function init(this, base, height, hypotenuse) {
        super.init("triangle");
        this.base = base;
        this.height = height;
        this.hypotenuse = hypotenuse;
    }

    function area(this) {
        return this.base * this.height / 2;
    }

    function perimeter(this) {
        return this.base + this.height + this.hypotenuse;
    }

    function scale(this, factor) {
        this.base = this.base * factor;
        this.height = this.height * factor;
        this.hypotenuse = this.hypotenuse * factor;
        return this;
    }
}

function total_area(shapes) {
    var total = 0;
    for shape in shapes {
        total = total + shape.area();
    }
    return total;
}

function descriptions(shapes) {
    var result = [];
    for shape in shapes {
        result = result + [shape.describe()];
    }
    return result;
}

const RECTANGLE = Rectangle(3, 4);
const SQUARE = Square(5);
const TRIANGLE = RightTriangle(3, 4, 5);
const SHAPES = [RECTANGLE, SQUARE, TRIANGLE];
const SAVED_AREA = RECTANGLE.area;

print(TITLE);
print(Shape("base").describe());
for description in descriptions(SHAPES) {
    print(description);
}
print("total:", total_area(SHAPES));
RECTANGLE.scale(2);
SQUARE.scale(3);
TRIANGLE.scale(2);
print("scaled:", RECTANGLE.area(), SQUARE.area(), TRIANGLE.area());
print("perimeters:", RECTANGLE.perimeter(), SQUARE.perimeter(), TRIANGLE.perimeter());
print("saved method:", SAVED_AREA());
print("square:", SQUARE.describe());
print("total scaled:", total_area(SHAPES));
print("empty:", total_area([]), descriptions([]));
print("chain:", Rectangle(2, 3).scale(2).scale(2).area());
print("identity:", SHAPES[0] == RECTANGLE, Rectangle(3, 4) == Rectangle(3, 4));