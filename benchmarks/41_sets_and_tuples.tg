// 41_sets_and_tuples.tg - set and tuple regression workload.
//
// Exercises the two collection types the roadmap listed as missing: set literals
// and de-duplication, membership with `in`, add/remove/has/clear, the union,
// intersection, and difference operations, conversion with set()/list()/tuple(),
// iteration order, tuple literals in all three shapes, indexing, slicing,
// concatenation and destructuring, structural equality, the sequence built-ins
// over tuples, JSON and formatting, and every rejection path with try/catch.

print("== set literals ==");
const digits = {3, 1, 4, 1, 5, 9, 2, 6, 5, 3};
print(digits, len(digits), digits.size(), digits.length());
print(type(digits), isinstance(digits, "set"), isinstance(digits, ["set", "list"]));
print(type({}), type({1}), type(set()), type((1, 2)), type((1)));
print(set(), set([1, 1, 2]), set((2, 1)), set("banana"), set({"a": 1, "b": 2}));
print({1, 2} == {2, 1}, {1, 2} == {1, 2, 3}, {1} != {2}, {} == {});

print("== set membership ==");
var vowels = set("aeiou");
print("a" in vowels, "z" in vowels, vowels.has("i"), vowels.has("y"));
print(2 in digits, 7 in digits, len(vowels), vowels);
vowels.add("y");
vowels.add("a");
print(vowels, vowels.remove("y"), vowels.remove("y"), vowels);

print("== set algebra ==");
const odds = {1, 3, 5, 7};
const evens = {2, 4, 6};
print(odds.union(evens), odds.intersection({3, 9}), odds.difference({3, 5}));
print(odds.union([9, 1]), odds.intersection("123"), odds.difference((1,)));
print(odds.union(set()), odds.intersection(odds), odds.difference(odds));
print(odds, {1, 2}.union({3}), odds);
var copied = odds.union(set());
copied.add(11);
print(odds, copied);

print("== set iteration ==");
var total = 0;
for value in {4, 2, 8} {
    total += value;
}
print("total", total);
for letter in set("cab") {
    print("letter", letter);
}
const counted = {};
for value in digits {
    counted[value] = true;
}
print(counted.keys(), len(counted));
print(list(digits), sorted(list({5, 3, 9})), sum(list({1, 2, 3})), any(list({0, 1})), all(list({1, 2})));
print(list(vowels), tuple(vowels), len(tuple(vowels)));


print("== tuple literals ==");
const pair = (10, 20);
print(pair, len(pair), pair.size(), pair.length(), type(pair), type((10)));
print((1,), (), (1, 2, 3), type(()), isinstance(pair, "tuple"), isinstance(pair, "list"));
print((1, 2, 3, 4)[0], (1, 2, 3, 4)[-1], (1, 2, 3, 4)[1:3], (1, 2, 3, 4)[::-1], (1, 2, 3, 4)[::2]);
print((1, 2) == (1, 2), (1, 2) == (2, 1), (1, 2) == [1, 2], (1,) == (1, 2), () == ());
print(2 in (1, 2), 3 in (1, 2), (1, 2) + (3, 4), tuple([1, 2]) + tuple("ab"));
print(bool(()), bool((0,)), bool(set()), bool({0}), bool({}), bool({0: 1}));
const [left, right] = pair;
print("destructured", left, right);
const nested = (1, (2, 3), {4, 5});
print(nested, nested[1], nested[2], nested[1][1]);

print("== tuples as sequences ==");
print(sum((1, 2, 3)), min((3, 1, 2)), max((3, 1, 2)), any((0, 1)), all((1, 2)));
print(enumerate((7, 8)), zip((1, 2), ("a", "b")), zip((1, 2, 3), (4, 5)));
print(map((1, 2), function(v) { return v * 10; }), filter((1, 2, 3), function(v) { return v != 2; }));
print(sorted((3, 1, 2)), sorted((3, 1, 2), reverse=true), sorted(("bb", "a"), key=len));
function total_of(first, second) {
    return first + second;
}
print(total_of(*(1, 2)), total_of(*pair));

print("== conversion and json ==");
print(list((1, 2)), tuple([1, 2]), set([1, 2]), set((1, 2)), list("ab"), tuple({"x": 1}));
print((1, (2, 3)).ToString(), (1, 2).ToBool(), set().ToBool(), {0}.ToBool());
print(json.stringify((1, (2, 3))), json.stringify([(1, 2)]), json.stringify({}));

print("== errors ==");
function fails(action) {
    try {
        action();
        return "no error";
    } catch (error) {
        return str(error);
    }
}
function unhashable_element() {
    return {[1, 2]};
}
function nested_set() {
    return {{1, 2}};
}
function null_element() {
    return {null};
}
function set_index() {
    return {1, 2}[0];
}
function set_slice() {
    return {1, 2}[0:1];
}
function set_store() {
    const items = {1, 2};
    items[0] = 9;
    return "stored";
}
function tuple_store() {
    const items = (1, 2);
    items[0] = 9;
    return "stored";
}
function tuple_append() {
    return (1, 2).append(3);
}
function set_append() {
    return {1}.append(2);
}
function set_key() {
    return {{1}: 2};
}
function tuple_key() {
    return {(1, 2): 3};
}
function set_from_number() {
    return set(9);
}
function set_extra_argument() {
    return set([1], [2]);
}
function set_add_argument() {
    return {1}.add();
}
function union_number() {
    return {1}.union(9);
}
function sum_of_set() {
    return sum({1, 2});
}
function sorted_set() {
    return sorted({1, 2});
}
function zip_number() {
    return zip((1,), 9);
}
function set_json() {
    return json.stringify({1});
}
print("elements", "list cannot be a set element" in fails(unhashable_element), "set cannot be a set element" in fails(nested_set));
print("null", "null cannot be a set element" in fails(null_element), "tuple cannot be a dictionary key" in fails(tuple_key));
print("positions", "set cannot be indexed" in fails(set_index), "set cannot be sliced" in fails(set_slice));
print("stores", "cannot assign an index of set" in fails(set_store), "cannot assign an index of tuple" in fails(tuple_store));
print("methods", "set has no property \"append\"" in fails(set_append), "tuple has no property \"append\"" in fails(tuple_append));
print("keys", "set cannot be a dictionary key" in fails(set_key));
print("constructors", "set expects an iterable, got number" in fails(set_from_number), "at most 1 argument" in fails(set_extra_argument));
print("arguments", "add expects 1 argument" in fails(set_add_argument), "union expects an iterable" in fails(union_number));
print("sequences", "expects a list or tuple, got set" in fails(sum_of_set), "sorted expects a list or tuple" in fails(sorted_set));
print("zip", "zip expects lists or tuples" in fails(zip_number), "cannot serialize set" in fails(set_json));

print("== mixed workload ==");
const seen = set();
var unique = [];
for word in ["red", "blue", "red", "green", "blue", "red"] {
    if !seen.has(word) {
        seen.add(word);
        unique += [word];
    }
}
print(unique, len(seen), seen.union(["amber"]), seen.intersection(["red", "amber"]));
const inventory = {};
for entry in [("apple", 2), ("pear", 5), ("apple", 3)] {
    const [name, count] = entry;
    if name in inventory {
        inventory[name] = inventory[name] + count;
    } else {
        inventory[name] = count;
    }
}
print(inventory, len(inventory));
const pairs = {};
for name in inventory.keys() {
    pairs[name] = (name, inventory[name]);
}
print(pairs, pairs["pear"][1], type(pairs["apple"]));
print(sorted(pairs.values(), key=function(entry) { return entry[0]; }));
print(len(seen.union(inventory.keys())), sorted(list(seen.union(inventory.keys()))));

print("done");

