// 40_syntax_gaps.tg - conditional expressions, slicing, loop labels, do...while,
// and assertions.
//
// A small report built from a table of readings: labels are chosen with
// conditional expressions, rows and columns are read with slices, nested loops
// are left with labeled break and continue, input is walked with do...while, and
// assertions guard what the report believes.

print("== conditional expressions ==");
function sign(value) {
    return "negative" if value < 0 else "zero" if value == 0 else "positive";
}
for value in [-2, 0, 5] {
    print(f"{value:>2} {sign(value)}");
}
print(str(3) + ("s" if 3 != 1 else ""));

print("== slicing a table ==");
const table = [
    ["north", 4, 12],
    ["south", 7, 3],
    ["east", 2, 9],
    ["west", 5, 6],
];
print(table[1:3]);
print(table[0][1:3]);
print(table[-2:]);
for row in table[::-1] {
    print(row[0], row[1:3]);
}
const header = "region   a  b";
print(header[:6], header[9:], header[::-1]);

print("== summing with slices ==");
var totals = [];
for row in table {
    const values = row[1:];
    var sum = 0;
    for value in values {
        sum = sum + value;
    }
    totals = totals + [sum];
}
print(totals);
print(sum(totals), max(totals), min(totals));
print(totals[::2], totals[::-1]);

print("== labeled break and continue ==");
outer: for row in table {
    for value in row[1:] {
        if value > 10 {
            print("skip", row[0]);
            continue outer;
        }
        if value < 3 {
            print("halt at", row[0], value);
            break outer;
        }
    }
    print("clean", row[0]);
}
print("scan done");

print("== do...while ==");
var attempts = 0;
do {
    attempts = attempts + 1;
    print("attempt", attempts);
} while (attempts < 3);
var confirmed = false;
do {
    print("confirming");
    confirmed = true;
} while (confirmed == false);
print("confirmed", confirmed);

print("== validation loop ==");
const samples = [4, -1, 8];
var index = 0;
do {
    const sample = samples[index];
    index = index + 1;
    if sample < 0 {
        print("rejected", sample);
        continue;
    }
    print("accepted", sample);
} while (index < len(samples));

print("== labeled while ==");
var rows = 0;
counting: while rows < 3 {
    rows = rows + 1;
    var columns = 0;
    while true {
        columns = columns + 1;
        if columns > rows {
            continue counting;
        }
        print(rows, columns);
    }
}

print("== assertions ==");
function ratio(part, whole) {
    assert whole != 0, "whole must be non-zero";
    return part / whole;
}
print(ratio(8, 2));

var checked = 0;
for value in [1, 2, 3] {
    assert value > 0;
    checked = checked + 1;
}
print("checked", checked);

function note(message) {
    print("evaluated", message);
    return message;
}
assert 2 > 1, note("never runs");
print("message is lazy");

try {
    assert 1 > 2, "one is not greater";
} catch (error) if error["kind"] == "assertion failed" {
    print(error["kind"], error["message"], "assertion failed" in error);
}

try {
    assert 1 > 2;
} catch (error) {
    print(error["message"]);
}

try {
    assert 1 > 2, ["rows", 3];
} catch (error) {
    print(error["message"]);
}

try {
    assert 0, "zero is falsey";
} catch (error) {
    print("zero", error["kind"]);
}
try {
    assert "", "empty text is falsey";
} catch (error) {
    print("empty text", error["kind"]);
}
try {
    assert [], "an empty list is falsey";
} catch (error) {
    print("empty list", error["kind"]);
}
try {
    assert null, "null is falsey";
} catch (error) {
    print("null", error["kind"]);
}

try {
    assert [0], "a populated list is truthy";
    assert "0", "non-empty text is truthy";
    assert -1, "a non-zero number is truthy";
    print("truthy checks passed");
} catch (error) {
    print("unexpected", error["message"]);
}

function verify(limit) {
    try {
        assert limit < 3, f"limit {limit} is too large";
        return "accepted";
    } finally {
        print("checked limit", limit);
    }
}
print(verify(2));
try {
    verify(5);
} catch (error) {
    print(error["kind"]);
}

print("done");
