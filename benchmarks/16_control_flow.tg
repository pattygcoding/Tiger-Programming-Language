/* Updates, parenthesized and bare headers, ranges, loop else, match, and switch fallthrough. */
function odd_sum(stop) {
    var total = 0;
    for (var index = 0; index < stop; ++index) {
        if index % 2 == 0 {
            continue;
        }
        total = total + index;
    } else {
        return total;
    }
}

function locate(values, target) {
    var position = 0;
    for value in values {
        if value == target {
            break;
        }
        position++;
    } else {
        return -1;
    }
    return position;
}

function describe(code) {
    var result = "";
    switch code {
        case 1:
        case 2:
            result = "small";
            break;
        case 3:
            result = "three";
        default:
            result = result + "!";
    }
    return result;
}

function triangular(size) {
    var total = 0;
    for (var row = 1; row <= size; row++) {
        for (var column = 1; column <= row; ++column) {
            total = total + column;
        }
    }
    return total;
}

function count_down(start) {
    var result = [];
    while start > 0 {
        result = result + [start--];
    } else {
        result = result + [0];
    }
    return result;
}

print("odd sums", odd_sum(10), odd_sum(0));
print("locations", locate([4, 7, 9], 7), locate([], 7));
print("switch", describe(1), describe(3), describe(9));
print("triangles", triangular(3), triangular(5));
print("countdown", count_down(3));

var value = 2;
print("updates", value++, ++value, value--, --value, value);
const slots = [10, 20];
var calls = 0;
function first() {
    calls++;
    return 0;
}
print("targets", slots[first()]++, ++slots[first()], calls);

var visited = [];
for number in range(6) {
    switch number {
        case 1:
            continue;
        case 4:
            break;
        default:
            visited = visited + [number];
    }
}
print("visited", visited);

var attempts = 0;
for (;;) {
    if ++attempts == 3 {
        break;
    }
} else {
    print("unreachable");
}
print("attempts", attempts);

var outer = 0;
for row in range(3) {
    for column in range(3) {
        if column == 1 {
            break;
        }
        outer++;
    } else {
        print("unreachable");
    }
} else {
    print("nested", outer);
}

print("ranges", range(2, 8, 2), range(3, -2, -2));

function grade(score, attendance, approved) {
    if (score >= 90 && attendance >= 90) {
        return "excellent";
    } else if ((score >= 80 && attendance >= 80) || approved) {
        return "pass";
    } else {
        return "fail";
    }
}
print("grades", grade(95, 91, false), grade(95, 85, false), grade(60, 60, true), grade(80, 79, false));

var probes = 0;
function probe(result) {
    probes++;
    return result;
}
if (probe(false) && probe(true)) {
    print("unreachable");
} else if (probe(true) || probe(false)) {
    probes = probes * 10;
}
print("short circuit", probes);

var precedence = [];
if (true || false && false) {
    precedence += ["loose or"];
}
if ((true || false) && false) {
    precedence += ["unreachable"];
} else {
    precedence += ["grouped"];
}
print("precedence", precedence);

var squares = [];
for (var n = 1; n <= 20 && n * n <= 30; n++) {
    squares += [n];
}
var continued = [];
for (var k = 0; k < 3 || k % 4 != 0; k++) {
    continued += [k];
}
print("bounded", squares, continued);

var labels = [];
for (var code = 0; code < 4; code++) {
    if (code == 0) {
        labels += ["zero"];
    } else if (code % 2 == 1 && code > 1) {
        labels += ["odd>1"];
    } else {
        labels += [str(code)];
    }
}
print("labels", labels);

var flags = [];
for (var flag = 0; flag < 3; flag++) {
    if !flag { flags += ["zero"]; }
    elif flag != 1 || !(flag > 5) { flags += ["one"]; }
    else { flags += ["many"]; }
}
print("flags", flags);

var walked = [];
var head = 0;
for head = 0; head < 3; head++ { walked += [head]; }
for var step = 0; step < 4; step++ { head += step; }
print("clause styles", walked, head);

function classify(value) {
    match value {
        case 0: return "none";
        case 1: return "one";
        case _: return "many";
    }
}
print("classify", classify(0), classify(1), classify(7));