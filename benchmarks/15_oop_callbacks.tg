const TITLE = "Bound methods and callbacks";

class Counter {
    function init(this, initial) {
        this.value = initial;
    }

    function add(this, amount) {
        this.value = this.value + amount;
        return this.value;
    }

    function callback(this, factor) {
        function later(amount) {
            return this.add(amount * factor);
        }
        return later;
    }

    function reset(this) {
        this.value = 0;
    }
}

class LoggedCounter(Counter) {
    function init(this, initial) {
        super.init(initial);
        this.history = [];
    }

    function add(this, amount) {
        const result = super.add(amount);
        this.history = this.history + [result];
        return result;
    }

    function silent_callback(this) {
        return super.add;
    }
}

class Dispatcher {
    function init(this) {
        this.listeners = [];
    }

    function subscribe(this, handler) {
        this.listeners = this.listeners + [handler];
        return this;
    }

    function emit(this, value) {
        var results = [];
        for handler in this.listeners {
            results = results + [handler(value)];
        }
        return results;
    }
}

class Adder {
    function init(this, offset) {
        this.offset = offset;
    }

    function transform(this, value) {
        return value + this.offset;
    }
}

class Multiplier {
    function init(this, factor) {
        this.factor = factor;
    }

    function transform(this, value) {
        return value * this.factor;
    }
}

class Pipeline {
    function init(this, stages) {
        this.stages = stages;
    }

    function apply(this, value) {
        var result = value;
        for stage in this.stages {
            result = stage.transform(result);
        }
        return result;
    }

    function map(this, values) {
        var results = [];
        for value in values {
            results = results + [this.apply(value)];
        }
        return results;
    }
}

function identity(value) {
    return value;
}

const FIRST = LoggedCounter(0);
const SECOND = Counter(10);
const EVENTS = Dispatcher().subscribe(FIRST.add).subscribe(SECOND.add);
const SAVED = FIRST.add;
const CALLBACK = FIRST.callback(2);
const SILENT = FIRST.silent_callback();
const PIPELINE = Pipeline([Adder(3), Multiplier(2)]);

print(TITLE);
print("event one:", EVENTS.emit(2));
print("event two:", EVENTS.emit(3));
print("saved:", SAVED(4), FIRST.history);
print("closure:", CALLBACK(3), FIRST.history);
print("silent:", SILENT(1), FIRST.history);
FIRST.operation = SECOND.add;
print("stored receiver:", FIRST.operation(5), FIRST.value, SECOND.value);
FIRST.transform = identity;
print("function field:", FIRST.transform(7));
print("pipeline:", PIPELINE.map([1, 2, 3]));
const APPLY = PIPELINE.apply;
print("bound pipeline:", APPLY(4));
PIPELINE.stages[0].offset = 5;
print("updated pipeline:", APPLY(4));
print("equality:", SAVED == FIRST.add, SAVED == SECOND.add);
print("empty:", Dispatcher().emit(1), PIPELINE.map([]));
print("reset:", SECOND.reset(), SECOND.value, FIRST.value);