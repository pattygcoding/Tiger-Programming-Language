const TITLE = "Arithmetic and number theory";

function absolute(value) {
    if value < 0 {
        return -value;
    }
    return value;
}

function power(base, exponent) {
    var result = 1;
    var remaining = exponent;
    while remaining > 0 {
        result = result * base;
        remaining = remaining - 1;
    }
    return result;
}

function gcd(first, second) {
    var left = absolute(first);
    var right = absolute(second);
    while right != 0 {
        const remainder = left % right;
        left = right;
        right = remainder;
    }
    return left;
}

function lcm(first, second) {
    if first == 0 or second == 0 {
        return 0;
    }
    return absolute(first * second) / gcd(first, second);
}

function triangular(limit) {
    var total = 0;
    var current = 1;
    while current <= limit {
        total = total + current;
        current = current + 1;
    }
    return total;
}

function sum_squares(limit) {
    var total = 0;
    var current = 1;
    while current <= limit {
        total = total + current * current;
        current = current + 1;
    }
    return total;
}

function clamp(value, lower, upper) {
    if value < lower {
        return lower;
    } elif value > upper {
        return upper;
    } else {
        return value;
    }
}

function digit_sum(value) {
    var remaining = absolute(value);
    var total = 0;
    while remaining > 0 {
        const digit = remaining % 10;
        total = total + digit;
        remaining = (remaining - digit) / 10;
    }
    return total;
}

function factorial(limit) {
    var result = 1;
    var current = 2;
    while current <= limit {
        result = result * current;
        current = current + 1;
    }
    return result;
}

function is_prime(value) {
    if value < 2 {
        return false;
    }
    var divisor = 2;
    while divisor * divisor <= value {
        if value % divisor == 0 {
            return false;
        }
        divisor = divisor + 1;
    }
    return true;
}

print(TITLE);
print("absolute:", absolute(-17), absolute(0), absolute(9));
print("powers:", power(2, 10), power(3, 4), power(9, 0));
print("gcd:", gcd(48, 18), gcd(-42, 30), gcd(0, 7));
print("lcm:", lcm(12, 18), lcm(0, 9));
print("triangular:", triangular(10), triangular(100));
print("squares:", sum_squares(5), sum_squares(10));
print("clamp:", clamp(-2, 0, 10), clamp(5, 0, 10), clamp(12, 0, 10));
print("digits:", digit_sum(12345), digit_sum(-909), digit_sum(0));
print("factorial:", factorial(0), factorial(5), factorial(8));
print("prime:", is_prime(1), is_prime(2), is_prime(29), is_prime(49));
print("precedence:", 2 + 3 * 4, (2 + 3) * 4, 24 / 3 / 2);
print("remainders:", -17 % 5, 17 % -5, -17 % -5);
print("fractions:", 7 / 2, 1.25 + 2.5, 1e2 + 2);