// Base class definition
class Animal {
    function init(this, name, species) {
        this.name = name;
        this.species = species;
    }

    function speak(this) {
        return this.name + " makes a generic sound.";
    }

    function describe(this) {
        return this.name + " is a " + this.species + ".";
    }
}

// Derived class with inheritance
class Dog(Animal) {
    function init(this, name, breed) {
        super.init(name, "Canine");
        this.breed = breed;
    }

    function speak(this) {
        return this.name + " barks!";
    }

    function fetch(this, item) {
        return this.name + " fetches the " + item + ".";
    }
}

// Instantiation and usage
const pet = Dog("Rex", "German Shepherd");
print(pet.describe());
print(pet.speak());
print(pet.fetch("ball"));