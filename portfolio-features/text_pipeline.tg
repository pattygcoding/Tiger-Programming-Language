const TITLE = "Text pipeline";
const MESSAGE = "tiger builds small language tools";

function split_words(text) {
    var words = [];
    var current = "";
    var index = 0;
    while index < len(text) {
        const character = text[index];
        if character == " " {
            if current != "" {
                words = words + [current];
                current = "";
            }
        } else {
            current = current + character;
        }
        index = index + 1;
    }
    if current != "" {
        words = words + [current];
    }
    return words;
}

function reverse(text) {
    var result = "";
    var index = len(text) - 1;
    while index >= 0 {
        result = result + text[index];
        index = index - 1;
    }
    return result;
}

function join(words, separator) {
    var result = "";
    var first = true;
    for word in words {
        if not first {
            result = result + separator;
        }
        result = result + word;
        first = false;
    }
    return result;
}

function initials(words) {
    var result = "";
    for word in words {
        result = result + word[0];
    }
    return result;
}

function frequencies(words) {
    const counts = {};
    for word in words {
        if word in counts {
            counts[word] = counts[word] + 1;
        } else {
            counts[word] = 1;
        }
    }
    return counts;
}

function longest(words) {
    var winner = "";
    for word in words {
        if len(word) > len(winner) {
            winner = word;
        }
    }
    return winner;
}

const WORDS = split_words(MESSAGE);
print(TITLE);
print("source:", MESSAGE);
print("words:", WORDS);
print("count:", len(WORDS));
print("initials:", initials(WORDS));
print("longest:", longest(WORDS));
print("joined:", join(WORDS, " | "));
print("reverse:", reverse("Tiger"));
const COUNTS = frequencies(WORDS + ["tiger"]);
for word in COUNTS {
    print("frequency:", word, COUNTS[word]);
}
print("contains:", "tools" in WORDS, "code" in WORDS);
print("lookup:", WORDS[0], WORDS[-1]);
print("empty:", split_words(""), join([], ","));