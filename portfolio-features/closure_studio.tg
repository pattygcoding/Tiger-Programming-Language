const TITLE = "Closure studio";

def make_counter(label, start) {
    value = start;
    def next() {
        value = value + 1;
        return label + ": " + str(value);
    }
    return next;
}

def make_converter(rate, unit) {
    def convert(value) {
        return str(value * rate) + " " + unit;
    }
    return convert;
}

def map_values(values, transform) {
    result = [];
    for value in values {
        result = result + [transform(value)];
    }
    return result;
}

def filter_values(values, predicate) {
    result = [];
    for value in values {
        if predicate(value) {
            result = result + [value];
        }
    }
    return result;
}

def reduce_values(values, combine, initial) {
    result = initial;
    for value in values {
        result = combine(result, value);
    }
    return result;
}

def make_threshold(limit) {
    def matches(value) {
        return value >= limit;
    }
    return matches;
}

def compose(first, second) {
    def combined(value) {
        return first(second(value));
    }
    return combined;
}

def double(value) {
    return value * 2;
}

def add_three(value) {
    return value + 3;
}

def add(left, right) {
    return left + right;
}

const BUILD = make_counter("build", 0);
const TEST = make_counter("test", 10);
const TO_KM = make_converter(1.609, "km");
const AT_LEAST_FIVE = make_threshold(5);
const PIPELINE = compose(double, add_three);
const VALUES = [1, 3, 5, 8, 13];
print(TITLE);
print(BUILD());
print(BUILD());
print(TEST());
print(BUILD());
print("distances:", map_values([1, 2, 5], TO_KM));
print("filtered:", filter_values(VALUES, AT_LEAST_FIVE));
print("sum:", reduce_values(VALUES, add, 0));
print("composed:", PIPELINE(4));
print("function:", BUILD);
print("independent:", TEST(), BUILD());