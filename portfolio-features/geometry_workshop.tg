const TITLE = "Geometry workshop";

class Shape {
    function init(this, name) {
        this.name = name;
    }

    function area(this) {
        return 0;
    }

    function describe(this) {
        return this.name + " area=" + str(this.area());
    }
}

class Rectangle(Shape) {
    function init(this, width, height) {
        super.init("rectangle");
        this.width = width;
        this.height = height;
    }

    function area(this) {
        return this.width * this.height;
    }

    function scale(this, factor) {
        this.width = this.width * factor;
        this.height = this.height * factor;
        return this;
    }
}

class Square(Rectangle) {
    function init(this, side) {
        super.init(side, side);
        this.name = "square";
    }

    function side(this) {
        return this.width;
    }

    function describe(this) {
        return super.describe() + " side=" + str(this.side());
    }
}

class Triangle(Shape) {
    function init(this, base, height) {
        super.init("triangle");
        this.base = base;
        this.height = height;
    }

    function area(this) {
        return this.base * this.height / 2;
    }

    function scale(this, factor) {
        this.base = this.base * factor;
        this.height = this.height * factor;
        return this;
    }
}

function total_area(shapes) {
    var total = 0;
    for shape in shapes {
        total = total + shape.area();
    }
    return total;
}

const RECTANGLE = Rectangle(3, 4);
const SQUARE = Square(5);
const TRIANGLE = Triangle(8, 3);
const SHAPES = [RECTANGLE, SQUARE, TRIANGLE];
print(TITLE);
for shape in SHAPES {
    print(shape.describe());
}
print("total:", total_area(SHAPES));
RECTANGLE.scale(2);
SQUARE.scale(3);
TRIANGLE.scale(2);
print("scaled rectangle:", RECTANGLE.describe());
print("scaled square:", SQUARE.describe());
print("scaled triangle:", TRIANGLE.describe());
print("updated total:", total_area(SHAPES));
print("chain:", Rectangle(2, 3).scale(2).area());