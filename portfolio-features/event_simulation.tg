const TITLE = "Event simulation";

function make_clock() {
    var tick = 0;
    function now() {
        tick = tick + 1;
        return tick;
    }
    return now;
}

class EventLog {
    function init(this) {
        this.events = [];
    }

    function record(this, time, actor, action) {
        const event = {"time": time, "actor": actor, "action": action};
        this.events = this.events + [event];
        return event;
    }

    function by_actor(this, actor) {
        var result = [];
        for event in this.events {
            if event["actor"] == actor {
                result = result + [event];
            }
        }
        return result;
    }

    function count(this) {
        return len(this.events);
    }
}

class Worker {
    function init(this, name, log, clock) {
        this.name = name;
        this.log = log;
        this.clock = clock;
        this.completed = 0;
    }

    function do_work(this, action) {
        this.completed = this.completed + 1;
        return this.log.record(this.clock(), this.name, action);
    }
}

function actions(events) {
    var result = [];
    for event in events {
        result = result + [event["action"]];
    }
    return result;
}

function action_counts(events) {
    const counts = {};
    for event in events {
        const action = event["action"];
        if action in counts {
            counts[action] = counts[action] + 1;
        } else {
            counts[action] = 1;
        }
    }
    return counts;
}

const CLOCK = make_clock();
const LOG = EventLog();
const ADA = Worker("Ada", LOG, CLOCK);
const LEE = Worker("Lee", LOG, CLOCK);
print(TITLE);
print(ADA.do_work("compile"));
print(LEE.do_work("review"));
print(ADA.do_work("test"));
print(LEE.do_work("deploy"));
print("events:", LOG.count());
print("Ada actions:", actions(LOG.by_actor("Ada")));
print("Lee actions:", actions(LOG.by_actor("Lee")));
print("completed:", ADA.completed, LEE.completed);
print("action counts:", action_counts(LOG.events));
for event in LOG.events {
    print("event", event["time"], event["actor"], event["action"]);
}