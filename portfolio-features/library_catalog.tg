const TITLE = "Library catalog";

class Book {
    function init(this, title, author, pages) {
        this.title = title;
        this.author = author;
        this.pages = pages;
        this.checked_out = false;
    }

    function borrow(this) {
        if this.checked_out {
            return false;
        }
        this.checked_out = true;
        return true;
    }

    function return_book(this) {
        this.checked_out = false;
        return this.title;
    }

    function describe(this) {
        var state = "available";
        if this.checked_out {
            state = "checked out";
        }
        return this.title + " by " + this.author + " (" + str(this.pages) + ", " + state + ")";
    }
}

class ReferenceBook(Book) {
    function borrow(this) {
        return false;
    }

    function describe(this) {
        return super.describe() + " [reference]";
    }
}

function available(books) {
    var result = [];
    for book in books {
        if not book.checked_out {
            result = result + [book.title];
        }
    }
    return result;
}

function page_total(books) {
    var total = 0;
    for book in books {
        total = total + book.pages;
    }
    return total;
}

function checked_out(books) {
    var result = [];
    for book in books {
        if book.checked_out {
            result = result + [book.title];
        }
    }
    return result;
}

const TIGER = Book("Tiger", "Mara", 240);
const MAPS = ReferenceBook("Atlas", "Ivo", 320);
const POEMS = Book("Night Lines", "Sora", 96);
const BOOKS = [TIGER, MAPS, POEMS];
const DESCRIBE_TIGER = TIGER.describe;
print(TITLE);
for book in BOOKS {
    print(book.describe());
}
print("borrow Tiger:", TIGER.borrow());
print("borrow Tiger again:", TIGER.borrow());
print("borrow Atlas:", MAPS.borrow());
print("available:", available(BOOKS));
print("checked out:", checked_out(BOOKS));
print("pages:", page_total(BOOKS));
print("saved method:", DESCRIBE_TIGER());
print("return:", TIGER.return_book());
print("available:", available(BOOKS));