const TITLE = "Number laboratory";

function gcd(left, right) {
    while right != 0 {
        const remainder = left % right;
        left = right;
        right = remainder;
    }
    return left;
}

function factorial(value) {
    var result = 1;
    while value > 1 {
        result *= value;
        value -= 1;
    }
    return result;
}

function fibonacci(count) {
    var values = [];
    var first = 0;
    var second = 1;
    while values.length() < count {
        values += [first];
        const next = first + second;
        first = second;
        second = next;
    }
    return values;
}

function is_prime(value) {
    if value < 2 {
        return false;
    }
    var divisor = 2;
    while divisor * divisor <= value {
        if value % divisor == 0 {
            return false;
        }
        divisor += 1;
    }
    return true;
}

function primes(limit) {
    var result = [];
    var candidate = 0;
    while candidate <= limit {
        if is_prime(candidate) {
            result += [candidate];
        }
        candidate += 1;
    }
    return result;
}

function summary(values) {
    var total = 0;
    for value in values {
        total += value;
    }
    return {"count": values.size(), "total": total, "average": total / values.length()};
}

function squares(values) {
    var result = [];
    for value in values {
        result += [value * value];
    }
    return result;
}

const FIBONACCI = fibonacci(10);
const PRIMES = primes(30);
const FIB_SUMMARY = summary(FIBONACCI);
print(TITLE, end="\n\n");
print("gcd:", gcd(84, 30));
print("factorial:", factorial(6));
print("fibonacci:", FIBONACCI);
print("primes:", PRIMES);
print("prime squares:", squares([2, 3, 5, 7]));
print("prime test:", is_prime(29), is_prime(30));
print("fib total:", FIB_SUMMARY["total"]);
print("fib average:", FIB_SUMMARY["average"]);
print("comparisons:", 3 < 4, 5 >= 5, 7 != 8);
print("math:", 17 / 2, 17 % 2, -5 + 12);