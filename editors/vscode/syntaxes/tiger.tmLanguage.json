{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tiger",
  "scopeName": "source.tiger",
  "fileTypes": ["tg"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#formatted-strings" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#class-declaration" },
    { "include": "#function-declaration" },
    { "include": "#module-members" },
    { "include": "#keywords" },
    { "include": "#literals" },
    { "include": "#builtins" },
    { "include": "#calls" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.tiger",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.tiger" } },
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.tiger" } }
        },
        {
          "name": "comment.line.double-slash.tiger",
          "begin": "//",
          "end": "$",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.tiger" } }
        }
      ]
    },
    "escapes": {
      "patterns": [
        { "name": "constant.character.escape.tiger", "match": "\\\\[nrt\\\\\"']" },
        { "name": "invalid.illegal.escape.tiger", "match": "\\\\." }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tiger",
          "begin": "\"",
          "end": "\"|$",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.tiger" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.tiger" } },
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "name": "string.quoted.single.tiger",
          "begin": "'",
          "end": "'|$",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.tiger" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.tiger" } },
          "patterns": [{ "include": "#escapes" }]
        }
      ]
    },
    "formatted-strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tiger",
          "begin": "([fF])(\")",
          "end": "\"|$",
          "beginCaptures": {
            "1": { "name": "storage.type.string.tiger" },
            "2": { "name": "punctuation.definition.string.begin.tiger" }
          },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.tiger" } },
          "patterns": [{ "include": "#formatted-content" }]
        },
        {
          "name": "string.quoted.single.tiger",
          "begin": "([fF])(')",
          "end": "'|$",
          "beginCaptures": {
            "1": { "name": "storage.type.string.tiger" },
            "2": { "name": "punctuation.definition.string.begin.tiger" }
          },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.tiger" } },
          "patterns": [{ "include": "#formatted-content" }]
        }
      ]
    },
    "formatted-content": {
      "patterns": [
        { "name": "constant.character.escape.tiger", "match": "\\{\\{|\\}\\}" },
        { "include": "#escapes" },
        {
          "name": "meta.interpolation.tiger",
          "contentName": "source.tiger",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.tiger" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.tiger" } },
          "patterns": [{ "include": "#nested-braces" }, { "include": "$self" }]
        }
      ]
    },
    "nested-braces": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.tiger" } },
      "endCaptures": { "0": { "name": "punctuation.tiger" } },
      "patterns": [{ "include": "#nested-braces" }, { "include": "$self" }]
    },
    "numbers": {
      "name": "constant.numeric.tiger",
      "match": "(?<![\\p{L}\\p{Nd}_])[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?"
    },
    "class-declaration": {
      "match": "(?<![\\p{L}\\p{Nd}_])(class)\\s+([\\p{L}_][\\p{L}\\p{Nd}_]*)(?:\\s+(extends)\\s+([\\p{L}_][\\p{L}\\p{Nd}_]*(?:\\s*\\.\\s*[\\p{L}_][\\p{L}\\p{Nd}_]*)?))?",
      "captures": {
        "1": { "name": "storage.type.class.tiger" },
        "2": { "name": "entity.name.type.class.tiger" },
        "3": { "name": "storage.modifier.extends.tiger" },
        "4": { "name": "entity.other.inherited-class.tiger" }
      }
    },
    "function-declaration": {
      "match": "(?<![\\p{L}\\p{Nd}_])(function)\\s+([\\p{L}_][\\p{L}\\p{Nd}_]*)",
      "captures": {
        "1": { "name": "storage.type.function.tiger" },
        "2": { "name": "entity.name.function.tiger" }
      }
    },
    "module-members": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{Nd}_.])(math)\\s*(\\.)\\s*(ceil|floor|round|sqrt|abs|pow|log|sin|cos|tan|min|max)(?![\\p{L}\\p{Nd}_])",
          "captures": {
            "1": { "name": "support.module.tiger" },
            "2": { "name": "punctuation.accessor.tiger" },
            "3": { "name": "support.function.math.tiger" }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{Nd}_.])(algo)\\s*(\\.)\\s*(fibonacci|fibonacciList|factorial|factorialList|removeDuplicates|findMatches|takeInventory|findPlace|isPrime|rainwater|medianSorted|mergeKSorted|editDistance|regexMatch|slidingWindowMax|slidingWindowSumMax|slidingWindowMinLen|slidingWindowLongestUnique|slidingWindowMinSubstring|palindromeValid|palindromeCanBeValid|palindromeLongest|palindromeCount|palindromeMinCuts)(?![\\p{L}\\p{Nd}_])",
          "captures": {
            "1": { "name": "support.module.tiger" },
            "2": { "name": "punctuation.accessor.tiger" },
            "3": { "name": "support.function.algo.tiger" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "storage.type.tiger", "match": "(?<![\\p{L}\\p{Nd}_])(?:const|var|function|class|extends)(?![\\p{L}\\p{Nd}_])" },
        { "name": "keyword.control.import.tiger", "match": "(?<![\\p{L}\\p{Nd}_])(?:import|as)(?![\\p{L}\\p{Nd}_])" },
        { "name": "storage.modifier.tiger", "match": "(?<![\\p{L}\\p{Nd}_])(?:public|private|protected)(?![\\p{L}\\p{Nd}_])" },
        { "name": "keyword.control.tiger", "match": "(?<![\\p{L}\\p{Nd}_])(?:if|elif|else|cif|celse|while|for|cfor|return|break|continue|switch|case|default|try|catch|throw)(?![\\p{L}\\p{Nd}_])" },
        { "name": "variable.language.tiger", "match": "(?<![\\p{L}\\p{Nd}_])(?:this|super)(?![\\p{L}\\p{Nd}_])" },
        { "name": "keyword.operator.word.tiger", "match": "(?<![\\p{L}\\p{Nd}_])(?:and|or|not|in)(?![\\p{L}\\p{Nd}_])" }
      ]
    },
    "literals": {
      "name": "constant.language.tiger",
      "match": "(?<![\\p{L}\\p{Nd}_])(?:true|false|null)(?![\\p{L}\\p{Nd}_])"
    },
    "builtins": {
      "patterns": [
        { "name": "support.module.tiger", "match": "(?<![\\p{L}\\p{Nd}_.])(?:math|algo)(?![\\p{L}\\p{Nd}_])" },
        { "name": "support.function.builtin.tiger", "match": "(?<![\\p{L}\\p{Nd}_.])(?:print|input|str|int|float|bool|len|range|open|read_file|write_file|append_file|file_exists|remove_file)(?![\\p{L}\\p{Nd}_])" }
      ]
    },
    "calls": {
      "match": "([\\p{L}_][\\p{L}\\p{Nd}_]*)(?=\\s*\\()",
      "captures": { "1": { "name": "entity.name.function.call.tiger" } }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.logical.tiger", "match": "&&|\\|\\|" },
        { "name": "keyword.operator.update.tiger", "match": "\\+\\+|--" },
        { "name": "keyword.operator.unpack.tiger", "match": "\\*\\*" },
        { "name": "keyword.operator.comparison.tiger", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.assignment.compound.tiger", "match": "[+\\-*%]=" },
        { "name": "keyword.operator.assignment.tiger", "match": "=" },
        { "name": "keyword.operator.arithmetic.tiger", "match": "[+\\-*/%]" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.statement.tiger", "match": ";" },
        { "name": "punctuation.separator.comma.tiger", "match": "," },
        { "name": "punctuation.accessor.tiger", "match": "\\." },
        { "name": "punctuation.separator.colon.tiger", "match": ":" },
        { "name": "punctuation.section.brackets.tiger", "match": "[()\\[\\]{}]" }
      ]
    },
    "identifiers": {
      "name": "variable.other.tiger",
      "match": "[\\p{L}_][\\p{L}\\p{Nd}_]*"
    }
  }
}
